{
  "name": "tool-result-guard",
  "version": "0.1.0",
  "description": "Middleware that scans tool results, web pages and files for prompt injection before they reach the model, then passes, sanitizes, redacts, fences off or blocks them. Wraps AI SDK tools, MCP clients and plain functions.",
  "keywords": [
    "prompt-injection",
    "llm",
    "ai",
    "agent",
    "security",
    "guardrails",
    "middleware",
    "tool-calling",
    "mcp",
    "ai-sdk",
    "sanitize"
  ],
  "homepage": "https://github.com/acus9345/tool-result-guard#readme",
  "bugs": {
    "url": "https://github.com/acus9345/tool-result-guard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acus9345/tool-result-guard.git"
  },
  "license": "MIT",
  "author": "acus9345 <acus9345@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prelint": "npm run build",
    "lint": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "injection-scan": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
